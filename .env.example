# ── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Slack ─────────────────────────────────────────────────────────────
# Bot token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-...
# Signing secret from your Slack app settings
SLACK_SIGNING_SECRET=...
# Socket Mode app-level token (xapp-...)
SLACK_APP_TOKEN=xapp-...

# ── Microsoft Teams ───────────────────────────────────────────────────
TEAMS_APP_ID=...
TEAMS_APP_PASSWORD=...

# ────────────────────────────────────────────────────────────────────────────
# LOG CONNECTORS (configure any combination; at least one recommended)
# ────────────────────────────────────────────────────────────────────────────

# ── Seq (optional) ────────────────────────────────────────────────────
# Base URL of your Seq server, e.g. http://seq:5341
SEQ_URL=
# Seq API key (leave blank if authentication disabled)
SEQ_API_KEY=

# ── Azure Application Insights (optional) ─────────────────────────────
# Full connection string from Application Insights resource
AZURE_INSIGHTS_CONNECTION_STRING=
# Service principal credentials (leave blank to use DefaultAzureCredential)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Grafana Loki (optional) ───────────────────────────────────────────
# Base URL of your Loki instance
LOKI_URL=http://loki:3100
# Basic auth credentials (leave blank if auth is not required)
LOKI_USER=
LOKI_PASSWORD=

# ── Sentry (optional) ─────────────────────────────────────────────────
# Generate an auth token at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
# Your Sentry organization slug
SENTRY_ORG=
# Your Sentry project slug
SENTRY_PROJECT=

# ── Datadog (optional) ────────────────────────────────────────────────
# API key and Application key from https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=
DATADOG_APP_KEY=
# Datadog site — datadoghq.com (US), datadoghq.eu (EU), us3.datadoghq.com, etc.
DATADOG_SITE=datadoghq.com

# ── File logs (optional) ──────────────────────────────────────────────
# Comma-separated list of log file paths (absolute or relative)
FILE_LOG_PATHS=/var/log/app.log,/var/log/worker.log

# ────────────────────────────────────────────────────────────────────────────
# ISSUE TRACKERS (configure any combination)
# ────────────────────────────────────────────────────────────────────────────

# ── Jira (optional) ───────────────────────────────────────────────────
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@yourorg.com
JIRA_API_TOKEN=...
JIRA_PROJECT_KEY=PROJ

# ── Azure DevOps (optional) ───────────────────────────────────────────
AZURE_DEVOPS_URL=https://dev.azure.com/yourorg
AZURE_DEVOPS_PAT=...
AZURE_DEVOPS_PROJECT=YourProject

# ── Linear (optional) ─────────────────────────────────────────────────
# API key from https://linear.app/settings/api
LINEAR_API_KEY=lin_api_...

# ── PagerDuty (optional) ──────────────────────────────────────────────
# REST API key (v2) from https://support.pagerduty.com/docs/api-access-keys
PAGERDUTY_API_KEY=

# ── GitHub Issues (optional) ──────────────────────────────────────────
# Personal access token with repo:read scope
GITHUB_TOKEN=ghp_...
# Comma-separated list of "owner/repo" repositories to search
GITHUB_REPOS=myorg/backend,myorg/frontend

# ── General ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
